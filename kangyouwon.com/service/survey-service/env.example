# Survey Service 설정
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8004
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# 데이터베이스 설정
INIT_DATABASE=true
DATABASE_URL=postgresql://your_db_user:your_db_password_here@your_db_host:your_db_port/your_db_name

# JWT 설정
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Survey 관련 설정
SURVEY_TEMPLATE_PATH=/app/templates
SURVEY_RESPONSE_STORAGE_PATH=/app/responses
SURVEY_EXPORT_FORMAT=json

# 개발 환경 설정
ENVIRONMENT=development
DEBUG=true
