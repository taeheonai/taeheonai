# Materiality Service 설정
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8002
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# 데이터베이스 설정
INIT_DATABASE=true
DATABASE_URL=postgresql+asyncpg://postgres:ZtQKhXPQZLiyEgINSWDfRznAIcrJZhAx@gondola.proxy.rlwy.net:15963/railway

# JWT 설정
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Materiality 관련 설정
MATERIALITY_THRESHOLD=0.05
MATERIALITY_CALCULATION_METHOD=quantitative
MATERIALITY_REPORT_FORMAT=json

# 개발 환경 설정
ENVIRONMENT=development
DEBUG=true

# 프론트엔드 도메인 설정
FRONTEND_URL=https://www.taeheonai.com
SURVEY_BASE_URL=https://www.taeheonai.com/survey

# 네이버 뉴스 API 설정
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
NAVER_API_MIN_INTERVAL=0.4
NAVER_API_PER_KEYWORD_PAUSE=0.0
NAVER_API_MAX_RETRIES=3
NAVER_MAX_RESULTS_PER_KEYWORD=500
NAVER_UNIQUE_COMPANY_MAX_RESULTS=300
NAVER_KEYWORD_CONCURRENCY=4
