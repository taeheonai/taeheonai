# SLLM Training Environment Variables
# 이 파일을 .env로 복사하고 실제 값으로 수정하세요

# Model Configuration
MODEL_NAME=beomi/KoAlpaca-Polyglot-5.8B

# Data Configuration
DATA_PATH=./data/gri_all.jsonl
OUTPUT_DIR=./outputs/srlm-koalpaca-5.8b-qlora

# Training Hyperparameters
MAX_SEQ_LEN=1536
LR=2e-4
EPOCHS=2
BATCH=1
GRAD_ACC=8

# LoRA Configuration
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
TARGET_MODULES=query_key_value,dense_h_to_4h,dense_4h_to_h

# Hardware Configuration
DEVICE_MAP=auto
LOAD_IN_4BIT=true
BF16=true

# Logging Configuration
LOGGING_STEPS=25
SAVE_STEPS=500
EVAL_STEPS=500
SAVE_TOTAL_LIMIT=2

# Validation Configuration
VAL_SPLIT_RATIO=0.05
MIN_VAL_SIZE=50
SEED=42

# Output Configuration
DEFAULT_OUTPUT_FORMAT=adapter

# Environment Configuration
ENVIRONMENT=development
DEBUG=false
WANDB_PROJECT=sllm-gri-training
TENSORBOARD_DIR=./logs/tensorboard
